# Copy to .env and fill in. Never commit the real file.

# Postgres connection string (Supabase session pooler). After changing it, run: npm run db:push
DATABASE_URL=

# S3-compatible bucket that stores the photo files (Supabase Storage > S3).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Public URL of the bucket above; photo URLs are built from it. Inlined into the browser bundle at build time.
NEXT_PUBLIC_PHOTOS_URL=

# 32+ character random string that signs the session cookie (openssl rand -base64 32). Changing it signs everyone out.
AUTH_SECRET=

# Admin accounts are stored in the database: npm run admin:create -- <username>
